# This file was generated using interfaces-conf.cs from a configuration file.
# Do not edit this file directly, edit the configuration file instead.

# This file describes the network interfaces available on your system
# and how to activate them. For more information, see interfaces(5).

source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback

#####################################################
#                  Ethernet trunk                   #
#####################################################

auto trunk0
allow-hotplug trunk0
iface trunk0 inet manual
    # Native/untagged management VLAN on trunk0.
    # Tagged service VLANs: iot=100, mobile=200, external=300, guest=400
    bridge-vids 1 100 200 300 400 
    bridge-pvid 1

#####################################################
#              Wireless AP interfaces               #
#####################################################

# Access-style AP ports. Untagged Wi-Fi traffic is classified into the given VLAN.
auto radio0
iface radio0 inet manual
    bridge-access 100

auto radio1
iface radio1 inet manual
    bridge-access 200

auto radio2
iface radio2 inet manual
    bridge-access 300

auto radio3
iface radio3 inet manual
    bridge-access 400

#####################################################
#               VLAN-aware bridge                   #
#####################################################

# VLAN-aware bridge that aggregates the trunk and AP interfaces.
# The bridge is configured to request an IP address via DHCP on the native/management VLAN (VLAN 1).
auto br_trunk
iface br_trunk inet dhcp
    hwaddress ether a1:b2:c3:d4:e5:f6 # Optional: set a fixed MAC address for the bridge matching your upstream DHCP reservations.
    bridge-vlan-aware yes
    bridge-ports trunk0 radio0 radio1 radio2 radio3 
    bridge-stp off
    bridge-fd 0
    bridge-vids 1 100 200 300 400
    bridge-pvid 1
